# Откуда брать Claude:
#   api          — API-ключ (нужен ANTHROPIC_API_KEY ниже), для продукта и других пользователей
#   subscription — ваша подписка Claude Pro/Max через Claude Code CLI, только для личного использования
VIRALTHING_BACKEND=api

# Ключ для VIRALTHING_BACKEND=api: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Необязательно:
# VIRALTHING_MODEL=claude-opus-5
# VIRALTHING_EFFORT=high          # low | medium | high — ниже = быстрее и дешевле
# VIRALTHING_CLI_MODEL=opus      # модель для subscription (по умолчанию — модель аккаунта)
# WHISPER_MODEL=small        # tiny | base | small | medium — точность распознавания речи
